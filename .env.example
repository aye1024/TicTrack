# Copy to .env (gitignored), then fill in what you have.
# Everything here is optional: with a key missing, that feature falls back
# instead of breaking. Restart Expo after changing this file.

# --- Language model -------------------------------------------------------
# Zhipu BigModel. Unset, the app uses the local rules in src/llm/fallback.ts.
EXPO_PUBLIC_GLM_API_KEY=
# Avoid the glm-5.3-flash models: they cannot turn reasoning off, which blows
# the token budget the app sends. See the README.
EXPO_PUBLIC_GLM_MODEL=glm-5.2

# --- API server ----------------------------------------------------------
# Empty means the Expo packager host on port 3000. Set this to point every
# build at one hosted server instead.
EXPO_PUBLIC_API_URL=

# --- Speech to text ------------------------------------------------------
# Set at least one, or the microphone button is hidden and typing is the only
# way in. The app prefers streaming, so with several set it uses the first
# streaming one that has a key.
#
# ElevenLabs Scribe — the default, and the only one that covers both paths:
# streaming on the phone, batched in the browser. Paid, not a free tier.
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_ELEVENLABS_MODEL=scribe_v2
EXPO_PUBLIC_ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime

# Deepgram — streaming, text appears while you are still talking.
# $200 of credit on signup, no card. console.deepgram.com
EXPO_PUBLIC_DEEPGRAM_API_KEY=
EXPO_PUBLIC_DEEPGRAM_MODEL=nova-3

# Groq Whisper — transcribes after you stop, about a second of waiting.
# 2,000 requests a day, free permanently, no card. console.groq.com/keys
# This is the only provider that works in the browser build.
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_MODEL=whisper-large-v3-turbo

# iFlytek RTASR — streaming. No free tier; kept as a fallback.
EXPO_PUBLIC_XFYUN_APP_ID=
EXPO_PUBLIC_XFYUN_API_KEY=

# Force one provider: deepgram, groq, or xfyun. Empty picks automatically.
# Useful for checking the other path without moving keys around.
EXPO_PUBLIC_ASR_PROVIDER=
